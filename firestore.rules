rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public quote & enquiry submissions from website forms
    match /enquiries/{enquiryId} {
      // Allow visitors to create a new enquiry with basic validation
      allow create: if
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 0 &&
        request.resource.data.fullName.size() <= 200 &&
        request.resource.data.email is string &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        request.resource.data.source in ['homepage-quote', 'contact-page', 'enquiry-drawer'] &&
        request.resource.data.status == 'new';

      // Prevent public reading, updating, or deleting of buyer enquiries
      allow read, update, delete: if request.auth != null;
    }

    // Blog articles collection
    match /blogs/{blogId} {
      // Anyone can read published blog posts
      allow read: if resource.data.published == true;

      // Allow creating validated blog posts (restrict to request.auth != null in production if desired)
      allow create: if
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 250 &&
        request.resource.data.slug is string &&
        request.resource.data.slug.size() > 0 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.published is bool;

      allow update, delete: if request.auth != null;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

